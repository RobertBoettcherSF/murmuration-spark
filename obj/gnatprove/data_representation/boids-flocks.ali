V "GNAT Lib v16"
A -O2
A -gnatA
A -gnat2012
A -gnata
A -gnatwa
A -gnatR2js
A -gnatws
A -gnatx
A -gnatis
A -mtune=generic
A -march=x86-64
P ZX

RN
RV NO_DIRECT_BOOLEAN_OPERATORS
RV NO_IMPLICIT_CONDITIONALS
RV NO_DEFAULT_INITIALIZATION
RV NO_DYNAMIC_SIZED_OBJECTS
RV NO_IMPLEMENTATION_ASPECT_SPECIFICATIONS
RV NO_IMPLEMENTATION_ATTRIBUTES
RV NO_IMPLEMENTATION_PRAGMAS
RV NO_IMPLICIT_LOOPS

U boids.flocks%b	boids-flocks.adb	7dd6b997 NE OO PK
W boids%s		boids.adb		boids.ali
Z system.assertions%s	s-assert.adb		s-assert.ali

U boids.flocks%s	boids-flocks.ads	57ea50cb EE NE OO PK
W boids%s		boids.adb		boids.ali
Z system.assertions%s	s-assert.adb		s-assert.ali

